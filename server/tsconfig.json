{
  "compilerOptions": {
    "target": "es2025", //javascript/typescript version
    "module": "nodenext", //tells typescript how to handle imports and exportt packages
    "moduleResolution": "nodenext",
    "rootDir": "src", // tells typescript that all your source files lives inside src
    "outDir": "dist", // dist simply means distribution
    "types": ["node"], // typescript works with node modules
    "strict": true, // turns on all checks e.g synthax errors etc
    "esModuleInterop": true, // it lets us import packages
    "skipLibCheck": true, // checkes spelling errors
    "forceConsistentCasingInFileNames": true // prevent bug
  },
  "include": ["src"]
}
